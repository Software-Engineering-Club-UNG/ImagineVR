# Copy to .env and fill in. Never commit .env.

# --- AI model (OpenRouter) ---
# Leave the key empty to run with the built-in offline director (keyword-based, no AI).
OPENROUTER_API_KEY=
# Fast model by default; first-statement latency matters more than depth here.
IMAGINE_MODEL=anthropic/claude-haiku-5.5
# Optional: "off", "low", "medium", "high". Empty = provider default.
IMAGINE_REASONING=
# Optional: another OpenAI-compatible chat completions endpoint (a proxy, a test stub).
OPENROUTER_URL=

# --- Speech to text ---
# "local" = Whisper on this machine (faster-whisper). "elevenlabs" = ElevenLabs API.
IMAGINE_STT=local
# Whisper model size for local: tiny.en, base.en, small.en, medium.en
IMAGINE_STT_MODEL=base.en

# --- Spoken replies (optional) ---
IMAGINE_TTS=off
ELEVENLABS_API_KEY=
IMAGINE_TTS_VOICE=21m00Tcm4TlvDq8ikWAM

# --- Access ---
# Must match the app token in the Unity ImagineSettings asset.
IMAGINE_APP_TOKEN=dev-token
# Public base URL used in audio links, e.g. https://1-2-3-4.sslip.io (empty = derive from request)
IMAGINE_PUBLIC_URL=

# --- Files ---
# Defaults to ../shared/catalog.json
IMAGINE_CATALOG=
