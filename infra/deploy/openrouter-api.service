[Unit]
Description=ImagineVR FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openrouter-api
Group=openrouter-api
WorkingDirectory=/srv/openrouter-api/current
EnvironmentFile=-/etc/openrouter-api/environment
EnvironmentFile=/srv/openrouter-api/current/release.env
ExecStart=/srv/openrouter-api/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
