[Unit]
Description=ImagineVR FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openrouter-api
Group=openrouter-api
WorkingDirectory=/srv/openrouter-api/current
EnvironmentFile=-/etc/openrouter-api/environment
EnvironmentFile=/srv/openrouter-api/current/release.env
EnvironmentFile=-/etc/openrouter-api/public-url.env
ExecStart=/srv/openrouter-api/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=IMAGINE_ENV=production
Environment=IMAGINE_STT=local
# base.en or small.en: both are on disk after provisioning (see prepare-whisper.sh), and the
# server finds the one named here under IMAGINE_STT_CACHE. small.en hears better and takes
# about three times as long on this machine, on every spoken turn.
Environment=IMAGINE_STT_MODEL=base.en
Environment=IMAGINE_STT_CACHE=/var/cache/openrouter-api
Environment=HF_HOME=/var/cache/openrouter-api/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
CacheDirectory=openrouter-api
ReadWritePaths=/var/cache/openrouter-api
Environment=IMAGINE_PUBLIC_URL=https://64.177.52.162.sslip.io
Environment=IMAGINE_CATALOG=/srv/openrouter-api/current/shared/catalog.json
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
