#cloud-config
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${public_key}
ssh_pwauth: false
disable_root: true
package_update: true
packages:
  - unattended-upgrades
runcmd:
  - [systemctl, enable, --now, unattended-upgrades]
