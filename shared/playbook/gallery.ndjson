{"playbook":"a shooting gallery","ask":"a shooting range with moving targets","tags":["shooting","range","gallery","target","targets","aim","practice","carnival","fairground","sniper","marksman","skeet","duck","accuracy","pistol","rifle","archery","bow"]}
{"op":"think","text":"A fairground booth: a counter, three rows of targets sliding at different speeds, sixty seconds on the clock."}
{"op":"sky","preset":"golden_hour"}
{"op":"terrain","type":"flat","material":"dirt","patches":"grass"}
{"op":"spawn","id":"counter","asset":"cube","at":[0,0,1.1],"scale":[4,1,0.5],"tint":"#B03A2E","solid":true,"pattern":"stripes","pattern_color":"#F2E8D0","pattern_scale":0.4}
{"op":"spawn","id":"back","asset":"cube","at":[0,0,13],"scale":[14,5,0.3],"tint":"#2A3550","solid":true,"pattern":"stripes","pattern_color":"#3A4870","pattern_scale":1.2}
{"op":"spawn","id":"row_near","asset":"target","scale":0.6,"path":[[-5,0.6,7],[5,0.6,7]],"speed":1.5}
{"op":"spawn","id":"duck_a","asset":"rubber_duck","scale":2.5,"path":[[-6,1.3,9],[6,1.3,9]],"speed":3}
{"op":"spawn","id":"duck_b","asset":"rubber_duck","scale":2.5,"path":[[6,1.3,9.4],[-6,1.3,9.4]],"speed":4}
{"op":"spawn","id":"bullseye_far","asset":"target","scale":0.45,"path":[[-6,2.6,12],[6,2.6,12]],"speed":6}
{"op":"spawn","id":"bottles","asset":"mug","at":[-1.5,1.02,5],"physics":true,"repeat":6,"step":[0.6,0,0],"breaks":"glass"}
{"op":"spawn","id":"bottle_shelf","asset":"cube","at":[0,0,5],"scale":[4,1,0.4],"tint":"#6B4226","solid":true}
{"op":"give","asset":"target_pistol"}
{"op":"var","name":"score","value":0,"label":"Score"}
{"op":"timer","name":"clock","seconds":60,"label":"Time"}
{"op":"hud","objective":"Sixty seconds: far targets are worth more"}
{"op":"when","id":"near_hit","event":"hit","target":"row_near","if":"clock > 0","do":[{"act":"add","var":"score","by":1},{"act":"sound","name":"bell"},{"act":"burst","kind":"sparks"}]}
{"op":"when","id":"duck_hit","event":"hit","target":"rubber_duck","if":"clock > 0","do":[{"act":"add","var":"score","by":3},{"act":"sound","name":"pop"},{"act":"burst","kind":"confetti"}]}
{"op":"when","id":"far_hit","event":"hit","target":"bullseye_far","if":"clock > 0","do":[{"act":"add","var":"score","by":5},{"act":"sound","name":"chime"},{"act":"burst","kind":"sparkles"}]}
{"op":"when","id":"bottle","event":"hit","target":"mug","if":"clock > 0","do":[{"act":"add","var":"score","by":2},{"act":"sound","name":"glass"}]}
{"op":"when","id":"time_up","event":"becomes","test":"clock <= 0","do":[{"act":"win","text":"Time! {score} points"},{"act":"sound","name":"fanfare"}]}
{"op":"spawn","id":"again","asset":"push_button","at":[1.6,0,0.6],"solid":true,"label":"PLAY AGAIN"}
{"op":"when","id":"restart","event":"press","target":"again","do":[{"act":"set","var":"score","to":0},{"act":"set","var":"clock","to":60},{"act":"reset","target":"bottles"},{"act":"sound","name":"beep"}]}
{"op":"scatter","id":"bunting","asset":"flag","count":10,"area":"ring","radius":[7,9],"tint":"#E0C030"}
{"op":"music","mood":"playful"}
{"op":"say","text":"Step right up! Grip the pistol, trigger fires: sixty seconds, and the far targets pay best. Press the button to go again."}
