OPENROUTER_API_KEY=
IMAGINE_APP_TOKEN=dev-token
IMAGINE_MODEL=anthropic/claude-haiku-5.5
# Maximum wait for first model text, then for subsequent text chunks (seconds).
IMAGINE_FIRST_TOKEN_SECONDS=30
IMAGINE_STALL_SECONDS=15
IMAGINE_STT=local
IMAGINE_STT_MODEL=base.en
IMAGINE_TTS=off
# Production additionally requires IMAGINE_ENV=production and a strong app token.
# IMAGINE_PUBLIC_URL=https://64.177.52.162.sslip.io
OPENROUTER_URL=
# off (default), low, medium, high, or auto to leave it to the provider
IMAGINE_REASONING=off
# Language v3 (headsets that send play-v1). 0: one call per turn. 1: + a modeller per custom asset.
# 2 (default): + a detail pass and a play pass for new places. 3: + concept pictures (needs IMAGINE_IMAGES=on).
IMAGINE_DEPTH=2
# Voices for narration and characters: off, openrouter (same key), elevenlabs, local (Kokoro on this CPU), on.
# IMAGINE_TTS_MODEL=openai/gpt-4o-mini-tts
# Pictures (sky panoramas, posters) through OpenRouter's image API: on/off. Not shown by headsets yet.
IMAGINE_IMAGES=off
# IMAGINE_IMAGE_MODEL=google/gemini-2.5-flash-image
