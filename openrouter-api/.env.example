OPENROUTER_API_KEY=
IMAGINE_APP_TOKEN=dev-token
IMAGINE_MODEL=anthropic/claude-haiku-5.5
# Maximum wait for first model text, then for subsequent text chunks (seconds).
IMAGINE_FIRST_TOKEN_SECONDS=30
IMAGINE_STALL_SECONDS=15
IMAGINE_STT=local
IMAGINE_STT_MODEL=base.en
IMAGINE_TTS=off
# Production additionally requires IMAGINE_ENV=production and a strong app token.
# IMAGINE_PUBLIC_URL=https://64.177.52.162.sslip.io
OPENROUTER_URL=
# off (default), low, medium, high, or auto to leave it to the provider
IMAGINE_REASONING=off
